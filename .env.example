# Copy to .env for local frontend-only dev. Never commit real URLs with secrets (there are none here).
# On Vercel, set these in the dashboard (Project → Settings → Environment Variables) instead.

# Backend origin the frontend calls, e.g. https://hospital-api.onrender.com
# Read at Vite build time. Empty = same origin (only works for monolith serving).
VITE_API_URL="http://localhost:3000"
